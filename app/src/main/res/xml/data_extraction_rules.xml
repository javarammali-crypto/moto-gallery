<?xml version="1.0" encoding="utf-8"?>
<!-- The Private safe is encrypted with a key tied to this phone, so it is never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="safe/" />
        <exclude domain="database" path="safe.db" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="safe/" />
        <exclude domain="database" path="safe.db" />
    </device-transfer>
</data-extraction-rules>
